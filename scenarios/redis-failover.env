# S8c - Genuine Redis primary failover (HA profile only: ./scripts/deploy.sh --ha). The primary pod is
# force-deleted; Sentinel promotes the asynchronous replica.
DESCRIPTION="S8c Redis Sentinel failover at 6,000 fragments/s - variant B, HA profile only"
VARIANTS_APPLICABLE="b"
REQUIRES_PROFILE="ha"
EVENT_RATE=6000
WARMUP_SECONDS=60
RAMP_SECONDS=30
DURATION_SECONDS=240
REDIS_URI="redis-sentinel://redis-sentinel:26379#aggbench"
FAULT=redis-failover
FAULT_AT=60
