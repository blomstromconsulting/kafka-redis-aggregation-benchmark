# Scenario suites for ./scripts/benchmark.sh --suite <name>
SUITE_smoke="smoke"
SUITE_core="steady rolling abrupt-pod cold-pod rescheduling"
SUITE_full="smoke steady rolling abrupt-pod abrupt-container cold-pod rescheduling state-1s state-10s state-60s slow-ml redis-restart redis-loss correctness"
SUITE_extended="stress state-300s kafka-restart redis-failover"
