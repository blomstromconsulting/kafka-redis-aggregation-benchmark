# S8b - Redis crash that loses the last ~5 s of acknowledged writes (AOF disabled 5 s before SHUTDOWN NOSAVE;
# the restarted server loads the stale AOF). Models async-replication loss on failover. Tests Kafka replay recovery.
DESCRIPTION="S8b Redis crash losing ~5 s of acknowledged state at 6,000 fragments/s - variant B only"
VARIANTS_APPLICABLE="b"
EVENT_RATE=6000
WARMUP_SECONDS=60
RAMP_SECONDS=30
DURATION_SECONDS=240
FAULT=redis-loss
FAULT_AT=60
REDIS_LOSS_WINDOW_SECONDS=5
