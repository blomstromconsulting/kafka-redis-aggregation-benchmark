        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, kind) (rate(bench_action_e2e_seconds_bucket[30s])))",
          "legendFormat": "p99 {{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
