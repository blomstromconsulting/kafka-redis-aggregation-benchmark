# S9 - Correctness under duplicates, reordering, stale versions, missing fragments, transient downstream
# errors (including errors reported after a successful commit) and an abrupt pod kill.
DESCRIPTION="S9 correctness: 10% duplicates, 50% reordered, 5% stale, 5% missing, 1% downstream errors, pod kill"
EVENT_RATE=1000
WARMUP_SECONDS=30
RAMP_SECONDS=15
DURATION_SECONDS=150
OUT_OF_ORDER_PERCENT=50
DUPLICATE_PERCENT=10
STALE_PERCENT=5
MISSING_PERCENT=5
PERSISTENCE_ERROR_BEFORE_RATE=0.01
PERSISTENCE_ERROR_AFTER_COMMIT_RATE=0.01
ML_ERROR_RATE=0.01
FAULT=kill-pod
FAULT_AT=40
