# S6 - Aggregation state size: correlation window 60 s, cold pod replacement after the state has built up.
DESCRIPTION="S6 state size: 60 s correlation window, cold pod replacement, 6,000 fragments/s"
EVENT_RATE=6000
WARMUP_SECONDS=120
RAMP_SECONDS=30
DURATION_SECONDS=240
CORRELATION_WINDOW_MS=60000
REDIS_REPLAY_WINDOW=120s
FAULT=delete-pod
FAULT_AT=60
