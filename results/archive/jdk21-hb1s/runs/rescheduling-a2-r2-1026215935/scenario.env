# S5 - Frequent rescheduling: one graceful pod replacement every 45 s, 6 times, under continuous target load.
DESCRIPTION="S5 frequent rescheduling (6 replacements, every 45 s) at 6,000 fragments/s"
EVENT_RATE=6000
WARMUP_SECONDS=60
RAMP_SECONDS=30
DURATION_SECONDS=330
FAULT=reschedule
FAULT_AT=30
FAULT_INTERVAL=45
FAULT_COUNT=6
