# S8a - Redis restart (graceful pod delete; AOF is fsynced on shutdown, so no acknowledged state is lost).
DESCRIPTION="S8a Redis restart (graceful) at 6,000 fragments/s - variant B only"
VARIANTS_APPLICABLE="b"
EVENT_RATE=6000
WARMUP_SECONDS=60
RAMP_SECONDS=30
DURATION_SECONDS=240
FAULT=redis-restart
FAULT_AT=60
